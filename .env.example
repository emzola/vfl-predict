# Local development configuration. This file contains placeholders only.
APP_ENV=development

# Local PostgreSQL container. Set a local-only password in an untracked .env file.
POSTGRES_DB=vfl
POSTGRES_USER=vfl
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://vfl:replace-me@localhost:5432/vfl?sslmode=disable

# Provider configuration remains disabled by default. Phase 1 network runs require
# an explicit -allow-network flag or BET9JA_CONNECTIVITY_ENABLED=true.
BET9JA_TOURNAMENT_ID=14149
BET9JA_HISTORICAL_BASE_URL=https://vgls-vs001.akamaized.net/vfl/feeds/?/bet9javirtuals/en/America:Los_Angeles/gismo/
BET9JA_LIVE_BASE_URL=https://vglslive-vs001.akamaized.net/vfl/feeds/?/bet9ja/en/Europe:Berlin/gismo/
BET9JA_CONNECTIVITY_ENABLED=false
BET9JA_REQUESTS_PER_SECOND=0.1
BET9JA_REQUEST_SPACING_SECONDS=10
BET9JA_REQUEST_TIMEOUT_SECONDS=30
BET9JA_MAX_RETRIES=3
BET9JA_MAX_SEASONS=1
PREDICTION_SAFETY_BUFFER_SECONDS=30
PREDICTION_FREEZE_LEAD_SECONDS=90
PREDICTION_GENERATION_TIMEOUT_SECONDS=90
INTERNAL_API_TOKEN=
AUTOBET_CREDENTIALS_ENCRYPTION_KEY=
AUTOBET_INTERVAL_SECONDS=10
AUTOBET_DRY_RUN=true
AUTOBET_MAX_ODDS_AGE_SECONDS=180
BET9JA_REQUEST_TIMEOUT_MS=30000
# The bookmaker id and ticket endpoint shape come from the documented Bet9ja
# REST request. The ticket path session id is obtained dynamically from getInit;
# keep the API key outside the repository.
BET9JA_BOOKMAKER_ID=9478
BET9JA_INIT_URL=https://virtual.bet9ja.com/commonmenu/CommonDesktopMenu/getinit
BET9JA_API_KEY=
BET9JA_LIMIT_ID=1424
BET9JA_SELECTION_ID=uof:6/sr:sport:1/18/12?total=1.5
# Bet9ja ticket units: ₦1 = 10,000 units (for example, ₦50 = 500,000).
BET9JA_STAKE_SCALE=10000
BET9JA_ODDS_SCALE=10000

# Phase 4 private dashboard authentication. Keep real values in an untracked
# .env file or the process environment; never commit them.
AUTHORIZED_EMAIL=
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=5
MAILER_MODE=memory
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
RESEND_API_URL=https://api.resend.com
RESEND_API_KEY=
EMAIL_FROM=
MAGIC_LINK_TTL_MINUTES=10

# Production only: the dedicated cmd/migrate service owns schema changes.
# Development commands leave this unset so their historical migration-on-start
# behavior is preserved.
RUN_MIGRATIONS=

# Model settings
MODEL_ARTIFACT_DIR=/data/models
