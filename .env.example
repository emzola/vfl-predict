# Local development configuration. This file contains placeholders only.
APP_ENV=development

# Local PostgreSQL container. Set a local-only password in an untracked .env file.
POSTGRES_DB=vfl
POSTGRES_USER=vfl
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://vfl:replace-me@localhost:5432/vfl?sslmode=disable

# Provider configuration remains disabled by default. Phase 1 network runs require
# an explicit -allow-network flag or BET9JA_CONNECTIVITY_ENABLED=true.
BET9JA_TOURNAMENT_ID=14149
BET9JA_HISTORICAL_BASE_URL=https://vgls-vs001.akamaized.net/vfl/feeds/?/bet9javirtuals/en/America:Los_Angeles/gismo/
BET9JA_LIVE_BASE_URL=https://vglslive-vs001.akamaized.net/vfl/feeds/?/bet9ja/en/Europe:Berlin/gismo/
BET9JA_CONNECTIVITY_ENABLED=false
BET9JA_REQUESTS_PER_SECOND=0.1
BET9JA_REQUEST_SPACING_SECONDS=10
BET9JA_REQUEST_TIMEOUT_SECONDS=30
BET9JA_MAX_RETRIES=3
BET9JA_MAX_SEASONS=1
PREDICTION_SAFETY_BUFFER_SECONDS=30
PREDICTION_FREEZE_LEAD_SECONDS=90
PREDICTION_GENERATION_TIMEOUT_SECONDS=90
INTERNAL_API_TOKEN=
AUTOBET_INTERVAL_SECONDS=30
AUTOBET_HEADLESS=true
AUTOBET_DRY_RUN=true
BET9JA_VIRTUAL_URL=https://virtual.bet9ja.com/virtual/
BET9JA_VFL_TOURNAMENT_NAME=Euro League
BET9JA_USERNAME=
BET9JA_PASSWORD=
# Optional selector overrides. Leave blank to use built-in defaults.
# Multiple selectors can be provided with `;;` separators.
# Built-in login trigger defaults:
# button:has-text("Log In");;button:has-text("Login");;a:has-text("Login");;text=/\blog\s*in\b/i
BET9JA_LOGIN_TRIGGER_SELECTORS=
# Built-in username field defaults:
# input[name="username"];;input[name="userName"];;input[placeholder*="username" i];;input[type="text"]
BET9JA_USERNAME_SELECTORS=
# Built-in password field defaults:
# input[name="password"];;input[type="password"];;input[placeholder*="password" i]
BET9JA_PASSWORD_SELECTORS=
# Built-in login submit defaults:
# button:has-text("Login");;button:has-text("Log in");;button:has-text("Sign in");;text=/\blog\s*in\b/i
BET9JA_LOGIN_SUBMIT_SELECTORS=
# Built-in logged-in indicator defaults:
# text=/my\s*account/i;;text=/make\s*a\s*deposit/i;;text=/logout/i;;text=/sign\s*out/i;;text=/balance/i
BET9JA_LOGOUT_INDICATORS=
# Built-in tournament tab defaults:
# text="Euro League";;text=Euro League;;text=/Euro League/i
BET9JA_TOURNAMENT_SELECTORS=
# Built-in match row defaults:
# tr;;[role="row"];;.matches tr;;.table tr;;tbody tr
BET9JA_MATCH_ROW_SELECTORS=
# Built-in row expansion defaults:
# text=/^\+\d+$/;;text=/\+\d+/;;[aria-label*="more" i];;[title*="more" i]
BET9JA_MATCH_EXPAND_SELECTORS=
# Built-in Over 1.5 option defaults:
# text=/over\s*1[\.,]5/i;;button:has-text("Over 1.5");;button:has-text("Over 1,5")
BET9JA_OVER15_SELECTORS=
# Built-in stake input defaults:
# input[aria-label*="stake" i];;input[name*="stake" i];;input[placeholder*="stake" i];;input[placeholder*="amount" i];;input[type="number"]
BET9JA_STAKE_SELECTORS=
# Built-in place bet button defaults:
# button:has-text("Place Bet");;button:has-text("Book Bet");;button:has-text("Place bet");;text=/place\s*bet/i
BET9JA_PLACE_BET_SELECTORS=
# Built-in confirmation defaults: none
BET9JA_CONFIRM_SELECTORS=
# Built-in bet reference defaults:
# text=/reference/i;;text=/booking\s*code/i
BET9JA_BET_REFERENCE_SELECTORS=
# Built-in betslip remove defaults:
# button[aria-label*="remove" i];;button[title*="remove" i];;text=/^x$/i
BET9JA_BETSLIP_REMOVE_SELECTORS=

# Phase 4 private dashboard authentication. Keep real values in an untracked
# .env file or the process environment; never commit them.
AUTHORIZED_EMAIL=
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=5
MAILER_MODE=memory
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=
RESEND_API_URL=https://api.resend.com
RESEND_API_KEY=
EMAIL_FROM=
MAGIC_LINK_TTL_MINUTES=10

# Production only: the dedicated cmd/migrate service owns schema changes.
# Development commands leave this unset so their historical migration-on-start
# behavior is preserved.
RUN_MIGRATIONS=

# Model settings
MODEL_ARTIFACT_DIR=/data/models
