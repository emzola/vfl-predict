FROM golang:1.24-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/ops-api ./cmd/ops-api

FROM alpine:3.21
RUN addgroup -S vfl && adduser -S vfl -G vfl
WORKDIR /app
COPY --from=build /out/ops-api /app/ops-api
COPY db/migrations /app/db/migrations
USER vfl
EXPOSE 8090
ENTRYPOINT ["/app/ops-api"]
