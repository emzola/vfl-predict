FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/live-monitor ./cmd/live-monitor
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/prediction-worker ./cmd/prediction-worker
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/settlement-worker ./cmd/settlement-worker

FROM alpine:3.21
RUN addgroup -S vfl && adduser -S vfl -G vfl
WORKDIR /app
COPY --from=build /out/live-monitor /app/live-monitor
COPY --from=build /out/prediction-worker /app/prediction-worker
COPY --from=build /out/settlement-worker /app/settlement-worker
COPY db/migrations /app/db/migrations
USER vfl
ENTRYPOINT ["/app/live-monitor"]
