# Copy to /opt/bet9ja-vfl/.env.production on the VPS and chmod 600 it.
# Replace every REPLACE_* value out of band. This file is an example only.
# RELEASE_SHA is supplied automatically by the GitHub Actions deployment.
# GHCR_IMAGE_PREFIX is derived automatically from github.repository.

APP_DOMAIN=app.vflpredict.win
ACME_EMAIL=REPLACE_WITH_CERTIFICATE_CONTACT_EMAIL
APP_ENV=production
AUTHORIZED_EMAIL=REPLACE_WITH_PRIVATE_LOGIN_EMAIL
APP_BASE_URL=https://app.vflpredict.win
COOKIE_SECURE=true
INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN
AUTOBET_DEBUG=
AUTOBET_CREDENTIALS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

POSTGRES_DB=vfl
POSTGRES_USER=vfl
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD

MAILER_MODE=resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=REPLACE_WITH_VERIFIED_RESEND_SENDER
RESEND_API_URL=https://api.resend.com

# Provider configuration is intentionally explicit. The live-monitor service
# also requires -allow-network in the Compose command and keeps the existing
# minimum ten-second request spacing safeguard.
BET9JA_CONNECTIVITY_ENABLED=false
BET9JA_TOURNAMENT_ID=14149
BET9JA_HISTORICAL_BASE_URL=REPLACE_WITH_DOCUMENTED_HISTORICAL_BASE_URL
BET9JA_LIVE_BASE_URL=REPLACE_WITH_DOCUMENTED_LIVE_BASE_URL
BET9JA_REQUEST_SPACING_SECONDS=10
BET9JA_REQUEST_TIMEOUT_SECONDS=30
BET9JA_MAX_RETRIES=3
PREDICTION_SAFETY_BUFFER_SECONDS=30
PREDICTION_FREEZE_LEAD_SECONDS=90
PREDICTION_GENERATION_TIMEOUT_SECONDS=90
# The active production model. Historical and frozen records retain their
# original model versions.
PREDICTION_MODEL=dynamic_bayesian_team_strength

# Auto betting worker configuration.
AUTOBET_INTERVAL_SECONDS=10
AUTOBET_HEADLESS=false
AUTOBET_DRY_RUN=false
AUTOBET_PAGE_READY_TIMEOUT_MS=60000
BET9JA_VIRTUAL_URL=https://virtual.bet9ja.com/virtual/
BET9JA_VFL_TOURNAMENT_NAME=Euro League
# Optional worker fallback credentials. Prefer saving Bet9ja credentials from the
# dashboard after deployment; these env values are only used when no dashboard credentials exist.
BET9JA_USERNAME=REPLACE_WITH_BET9JA_USERNAME
BET9JA_PASSWORD=REPLACE_WITH_BET9JA_PASSWORD
# Optional selector overrides. Leave blank to use built-in defaults.
# Multiple selectors can be provided with `;;` separators.
# Built-in login trigger defaults:
# button:has-text("Log In");;button:has-text("Login");;a:has-text("Login");;text=/\blog\s*in\b/i
BET9JA_LOGIN_TRIGGER_SELECTORS=
# Built-in login panel label defaults:
# text=/^\s*username\s*$/i;;text=/^\s*password\s*$/i
BET9JA_LOGIN_PANEL_LABEL_SELECTORS=
# Built-in username field defaults:
# input[autocomplete="username"];;input[name*="phone" i];;input[name*="mobile" i];;input[type="tel"];;input[inputmode="numeric"];;input[type="text"];;input:not([type])
BET9JA_USERNAME_SELECTORS=
# Built-in password field defaults:
# input[autocomplete="current-password"];;input[name="password"];;input[type="password"];;input[placeholder*="password" i]
BET9JA_PASSWORD_SELECTORS=
# Built-in login submit defaults:
# button:has-text("Login");;button:has-text("Log in");;button:has-text("Sign in");;text=/\blog\s*in\b/i
BET9JA_LOGIN_SUBMIT_SELECTORS=
# Built-in login failure defaults. A visible match keeps the worker from
# treating an invalid-credentials or challenge page as a successful login.
# text=/invalid\s+(?:username|password|credentials)/i;;text=/incorrect\s+(?:username|password|credentials)/i;;text=/wrong\s+(?:username|password)/i;;text=/captcha/i;;text=/verification\s+(?:code|required)/i;;text=/too\s+many\s+login\s+attempts/i
BET9JA_LOGIN_FAILURE_SELECTORS=
# Built-in logged-in indicator defaults:
# text=/my\s*account/i;;text=/make\s*a\s*deposit/i;;text=/logout/i;;text=/sign\s*out/i;;text=/balance/i
BET9JA_LOGOUT_INDICATORS=
# Built-in tournament tab defaults:
# text="Euro League";;text=Euro League;;text=/Euro League/i
BET9JA_TOURNAMENT_SELECTORS=
# Built-in match row defaults:
# tr;;[role="row"];;.matches tr;;.table tr;;tbody tr
BET9JA_MATCH_ROW_SELECTORS=
# Built-in row expansion defaults:
# text=/^\+\d+$/;;text=/\+\d+/;;[aria-label*="more" i];;[title*="more" i]
BET9JA_MATCH_EXPAND_SELECTORS=
# Built-in Over 1.5 option defaults:
# text=/over\s*1[\.,]5/i;;button:has-text("Over 1.5");;button:has-text("Over 1,5")
BET9JA_OVER15_SELECTORS=
# Built-in stake input defaults:
# input[aria-label*="stake" i];;input[name*="stake" i];;input[placeholder*="stake" i];;input[placeholder*="amount" i];;input[type="number"];;input:not([type="hidden"])
BET9JA_STAKE_SELECTORS=
# Built-in betslip header default:
# text=/^betslip\s*\(\s*\d+\s*\)$/i
BET9JA_BETSLIP_HEADER_SELECTORS=
# Built-in place bet button defaults:
# button:has-text("Place Bet");;button:has-text("Book Bet");;button:has-text("Place bet");;text=/place\s*bet/i
BET9JA_PLACE_BET_SELECTORS=
# Built-in confirmation defaults: none
BET9JA_CONFIRM_SELECTORS=
# Built-in successful-placement defaults:
# text=/^\s*your\s+bet\s+has\s+been\s+placed\.?\s*$/i;;text=/^\s*bet\s+has\s+been\s+placed\.?\s*$/i;;text=/^\s*place\s+another\s+bet\s*$/i
BET9JA_SUCCESS_SELECTORS=
# Built-in bet reference defaults:
# text=/reference/i;;text=/booking\s*code/i
BET9JA_BET_REFERENCE_SELECTORS=
# Built-in betslip remove defaults:
# button[aria-label*="remove" i];;button[title*="remove" i];;button[aria-label*="delete" i];;button[title*="delete" i];;button[aria-label*="close" i];;button[title*="close" i];;button:has-text("×");;text=/^x$/i
BET9JA_BETSLIP_REMOVE_SELECTORS=
