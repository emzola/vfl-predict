# Copy to /opt/bet9ja-vfl/.env.production on the VPS and chmod 600 it.
# Replace every REPLACE_* value out of band. This file is an example only.
# RELEASE_SHA is supplied automatically by the GitHub Actions deployment.
# GHCR_IMAGE_PREFIX is derived automatically from github.repository.

APP_DOMAIN=app.vflpredict.win
ACME_EMAIL=REPLACE_WITH_CERTIFICATE_CONTACT_EMAIL
APP_ENV=production
AUTHORIZED_EMAIL=REPLACE_WITH_PRIVATE_LOGIN_EMAIL
APP_BASE_URL=https://app.vflpredict.win
COOKIE_SECURE=true
INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN

POSTGRES_DB=vfl
POSTGRES_USER=vfl
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD

MAILER_MODE=resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=REPLACE_WITH_VERIFIED_RESEND_SENDER
RESEND_API_URL=https://api.resend.com

# Provider configuration is intentionally explicit. The live-monitor service
# also requires -allow-network in the Compose command and keeps the existing
# minimum ten-second request spacing safeguard.
BET9JA_CONNECTIVITY_ENABLED=false
BET9JA_TOURNAMENT_ID=14149
BET9JA_HISTORICAL_BASE_URL=REPLACE_WITH_DOCUMENTED_HISTORICAL_BASE_URL
BET9JA_LIVE_BASE_URL=REPLACE_WITH_DOCUMENTED_LIVE_BASE_URL
BET9JA_REQUEST_SPACING_SECONDS=10
BET9JA_REQUEST_TIMEOUT_SECONDS=30
BET9JA_MAX_RETRIES=3
PREDICTION_SAFETY_BUFFER_SECONDS=30
PREDICTION_FREEZE_LEAD_SECONDS=90
# The release workflow changes this to dynamic_bayesian_team_strength only
# after the replay, shadow, registry approval, and worker checks pass.
PREDICTION_MODEL=bookmaker_first
